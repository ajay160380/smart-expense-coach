# ==============================================================================
# PaisaMitra (Smart Expense Coach) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your root directory and set real secrets before running.

# ── Django Application Configuration ──
# Required: Random 50+ character string for Django production cryptographic signing
DJANGO_SECRET_KEY=
# Set to False in production; True only during local development
DEBUG=False
# Comma-separated list of allowed hostnames/domains
ALLOWED_HOSTS=localhost,127.0.0.1,expense-coach-prxm.onrender.com
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
CORS_ALLOWED_ORIGINS=https://expense-coach-prxm.onrender.com,http://localhost:8081
# Comma-separated list of trusted origins for CSRF verification
CSRF_TRUSTED_ORIGINS=https://expense-coach-prxm.onrender.com

# ── Database Configuration ──
# Required in production: Full PostgreSQL connection URL (e.g. Supabase, Render Postgres)
DATABASE_URL=

# ── AI & LLM Services (Groq Cloud) ──
# Required: Groq Cloud API Key for LLM chat and Whisper voice transcription
GROQ_API_KEY=
# Optional: Model name for financial coach (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Internal Service Secrets (Must match between Django backend and Node WhatsApp Bot) ──
# Required: Secret used to authorize daily tips background trigger
DAILY_TIP_SECRET=
# Required: Secret used to authorize admin broadcast push notifications
ADMIN_PUSH_SECRET=
# Required: Shared HMAC secret for bot-to-Django internal communication
INTERNAL_BOT_SECRET=

# ── Email Delivery (SMTP / Resend) ──
# Backend to use (default: django.core.mail.backends.smtp.EmailBackend)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP Host (e.g. smtp.gmail.com)
EMAIL_HOST=smtp.gmail.com
# SMTP Port (587 for TLS, 465 for SSL)
EMAIL_PORT=587
# Use TLS for SMTP connection
EMAIL_USE_TLS=True
# SMTP username / sending email address
EMAIL_HOST_USER=
# SMTP password / app-specific password
EMAIL_HOST_PASSWORD=
# Default From email address for system emails
DEFAULT_FROM_EMAIL=
# Optional: Resend API key for HTTP port 443 transactional emails
RESEND_API_KEY=
# Sender email registered on Resend
RESEND_FROM_EMAIL=

# ── Mobile Push Notifications (Firebase Admin SDK) ──
# Path to service account JSON file, or raw JSON credential string
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Application Monitoring & Error Telemetry ──
# Optional: Sentry DSN URL for backend error reporting
SENTRY_DSN=

# ── Mobile App Configuration (Expo) ──
# Backend API base URL consumed by React Native client
EXPO_PUBLIC_API_URL=https://expense-coach-prxm.onrender.com

# ── WhatsApp Bot Configuration ──
# Port on which the Express status server runs
PORT=10000
# Internal or public URL for the WhatsApp bot to reach Django
DJANGO_URL=http://127.0.0.1:8000
# Admin WhatsApp number allowed to issue administrative bot commands (e.g. 919876543210@s.whatsapp.net)
MY_WHATSAPP_NUMBER=
