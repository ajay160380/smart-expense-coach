{
  "cli": {
    "version": ">= 5.9.0"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a,armeabi-v7a",
        "ORG_GRADLE_PROJECT_expo.useLegacyPackaging": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "play-store": {
      "channel": "production",
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a,armeabi-v7a",
        "ORG_GRADLE_PROJECT_expo.useLegacyPackaging": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
