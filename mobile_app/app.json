{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": [
      "paisamitra",
      "com.ajay160380.paisamitra",
      "com.googleusercontent.apps.600331588079-97q2pl2l6impkean30df3qig5t6rl7et"
    ],
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000,
      "url": "https://u.expo.dev/4159228e-c70e-46d2-a231-eda454c6eb0d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ajay160380.paisamitra",
      "infoPlist": {
        "NSCameraUsageDescription": "Expense Tracker uses the camera to scan bill receipts and invoices for expense logging.",
        "NSMicrophoneUsageDescription": "Expense Tracker uses the microphone to record voice notes to automatically log expenses.",
        "NSFaceIDUsageDescription": "Expense Tracker uses biometric authentication to secure your financial data.",
        "NSPhotoLibraryUsageDescription": "Expense Tracker needs access to your photos to upload receipts and bills.",
        "NSLocationWhenInUseUsageDescription": "Expense Tracker uses your location to auto-tag expense locations."
      }
    },
    "android": {
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F7FB"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.ajay160380.paisamitra",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-audio",
      "expo-font",
      "expo-asset",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Expense Tracker uses the camera to scan bill receipts and invoices for expense logging."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Expense Tracker uses your location to auto-tag expense locations."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Expense Tracker uses biometric authentication to secure your financial data."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C6FF7"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "AddExpenseWidget",
              "label": "Expense Tracker",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "description": "Quickly add an expense",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "WideExpenseWidget",
              "label": "Expense Tracker Wide",
              "minWidth": "280dp",
              "minHeight": "110dp",
              "description": "Wide expense tracker with quick add",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4159228e-c70e-46d2-a231-eda454c6eb0d"
      }
    },
    "owner": "ajay1506s-team",
    "runtimeVersion": "1.3.2"
  }
}